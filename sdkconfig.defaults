CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_PLAYER_ENABLE_AUDIO=y
CONFIG_ESP_PLAYER_ENABLE_VIDEO=y
CONFIG_ESP_PLAYER_ENABLE_FILE_IO=y
CONFIG_ESP_PLAYER_ENABLE_HTTP_IO=n
CONFIG_ESP_PLAYER_ENABLE_HLS_IO=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FAT: IDF defaults to no long filenames and the US code page, which turns every
# Chinese name on the card into an 8.3 short name transcoded through CP437 - the
# on-screen lists came out as mojibake on the first real board. Long filenames
# plus a UTF-8 API keep the names the card actually stores.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
# Short names on cards written by Chinese Windows are CP936 bytes; this is only
# used to transcode those fallback names.
CONFIG_FATFS_CODEPAGE_936=y

# FRAM persistence. The first board answers on 0x50..0x57, which is the MB85RC16
# bank aliasing (a lone AT24C512 would only ACK on 0x50). FramDevice still probes
# every bank with a write/read scratch test, so a wrong profile falls back to
# RAM-only instead of writing records to the wrong device.
CONFIG_STORYBOX_FRAM_CONFIRMED=y

# BLE control channel (NimBLE peripheral, same GATT layout as the Arduino app).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

